# ─── Sparx Bit — PRODUCTION environment ───
# Copy to ".env" on the server, fill the blanks, then `php artisan key:generate`.

APP_NAME="Sparx Bit"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.sparxbit.com

APP_LOCALE=en
APP_TIMEZONE=UTC

# ─── Database (MySQL on the VPS) ───
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sparx_bit
DB_USERNAME=sparx_bit_user
DB_PASSWORD=sparx_bit_password

# ─── Drivers (all use DB tables created by migrations) ───
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Mail (SendGrid) ───
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@app.sparxbit.com"
MAIL_FROM_NAME="Sparx Bit"

# ─── Social sign-in ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APPLE_CLIENT_ID=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=error
